services:
  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: techmove-db
    environment:
      - ACCEPT_EULA=Y
      - SA_PASSWORD=Your_password123
    ports:
      - "1433:1433"
    volumes:
      - db_data:/var/opt/mssql
    healthcheck:
      test: ["CMD", "/opt/mssql-tools18/bin/sqlcmd", "-S", "localhost", "-U", "sa", "-P", "Your_password123", "-Q", "SELECT 1", "-b"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s

  api:
    build:
      context: .
      dockerfile: TechMove.Api/Dockerfile
    container_name: techmove-api
    depends_on:
      db:
        condition: service_healthy
    environment:
      - ConnectionStrings__DefaultConnection=Server=db;Database=TechMoveDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;
      - ASPNETCORE_ENVIRONMENT=Development
    ports:
      - "5000:80"

  web:
    build:
      context: .
      dockerfile: TechMove.Web/Dockerfile
    container_name: techmove-web
    depends_on:
      api:
        condition: service_started
    environment:
      - ApiBaseUrl=http://techmove-api:80
      - ASPNETCORE_ENVIRONMENT=Development
    ports:
      - "5001:80"

volumes:
  db_data:
