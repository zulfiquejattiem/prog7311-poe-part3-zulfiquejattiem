FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# copy entire solution
COPY . .

# build Web
WORKDIR /app/TechMove.Web
RUN dotnet restore TechMove.Web.csproj
RUN dotnet publish TechMove.Web.csproj -c Release -o out

# runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/TechMove.Web/out ./

EXPOSE 80
ENTRYPOINT ["dotnet", "TechMove.Web.dll"]