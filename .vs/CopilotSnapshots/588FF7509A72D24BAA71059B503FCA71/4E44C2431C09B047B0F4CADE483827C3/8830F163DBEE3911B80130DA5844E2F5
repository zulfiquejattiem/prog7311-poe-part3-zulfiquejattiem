using Microsoft.AspNetCore.Builder;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using System;
using System.Net;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddControllersWithViews();

// ✅ Session (for JWT + username)
builder.Services.AddSession(options =>
{
    options.IdleTimeout = TimeSpan.FromHours(1);
    options.Cookie.HttpOnly = true;
    options.Cookie.IsEssential = true;
});

// ✅ API base URL (Docker OR local fallback)
var apiUrl = builder.Configuration["ApiBaseUrl"] ?? "https://localhost:7023";

// If running locally (not in container) and the configured apiUrl points to a container host
// like "api" or "techmove-api", fall back to localhost:5000 so the Web app can reach the API.
if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER")))
{
    try
    {
        if (Uri.TryCreate(apiUrl, UriKind.Absolute, out var tmp))
        {
            var host = tmp.Host;
            // if host looks like a docker service name, prefer localhost when not in container
            if (host.Equals("api", StringComparison.OrdinalIgnoreCase)
                || host.Equals("techmove-api", StringComparison.OrdinalIgnoreCase))
            {
                apiUrl = "http://localhost:5000";
            }
            else
            {
                // try DNS resolution; if it fails, fallback to localhost:5000
                try
                {
                    Dns.GetHostEntry(host);
                }
                catch
                {
                    apiUrl = "http://localhost:5000";
                }
            }
        }
    }
    catch
    {
        apiUrl = "http://localhost:5000";
    }
}

builder.Services.AddHttpClient("api", client =>
{
    client.BaseAddress = new Uri(apiUrl);
});

var app = builder.Build();

// ✅ Error handling
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}
else
{
    app.UseDeveloperExceptionPage();
}

// ✅ Middleware pipeline
app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseRouting();

app.UseSession(); // ✅ must come before auth usage

app.UseAuthorization();

// ✅ Default route (forces login first)
app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Auth}/{action=Login}/{id?}");

app.Run();