var builder = WebApplication.CreateBuilder(args);

builder.Services.AddControllersWithViews();

// Configure the Web app to use the API migrations assembly so EF can find migrations from TechMove.Api
builder.Services.AddDbContext<TechMove.Api.Data.ApplicationDbContext>(options =>
{
    var conn = builder.Configuration.GetConnectionString("DefaultConnection")
               ?? "Server=(localdb)\\mssqllocaldb;Database=TechMoveDb;Trusted_Connection=True;";

    options.UseSqlServer(conn, sql => sql.MigrationsAssembly("TechMove.Api"));
});

builder.Services.AddHttpClient("api", client =>
{
    client.BaseAddress = new Uri("http://localhost:5000/");
});

var app = builder.Build();

app.UseStaticFiles();
app.UseRouting();

app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");

app.Run();