@model TechMove.Shared.ServiceRequests.ServiceRequestCreateDto

<h2>Create Service Request</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Contract</label>
        <select asp-for="ContractId" class="form-control">
            @foreach (var c in ViewBag.Contracts)
            {
                <option value="@c.Id">@c.ClientName - @c.ServiceLevel</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="form-group">
        <label>Cost (USD)</label>
        <input asp-for="CostUSD" id="usdInput" class="form-control" />
    </div>

    <div class="form-group">
        <label>Cost (ZAR)</label>
        <input id="zarOutput" class="form-control" readonly />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Save</button>
</form>

<script>
    let rate = 18.5; // fallback

    fetch("https://api.exchangerate.host/latest?base=USD&symbols=ZAR")
        .then(res => res.json())
        .then(data => rate = data.rates.ZAR);

    document.getElementById("usdInput").addEventListener("input", function () {
        let usd = parseFloat(this.value) || 0;
        document.getElementById("zarOutput").value = (usd * rate).toFixed(2);
    });
</script>