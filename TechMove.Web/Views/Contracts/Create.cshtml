@model TechMove.Shared.Contracts.ContractCreateDto

<h2>Create Contract</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div>
        <label>Client</label>
        <select asp-for="ClientId" class="form-control">
            @foreach (var c in ViewBag.Clients)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>

    <div>
        <label>Service Level</label>
        <input asp-for="ServiceLevel" class="form-control" />
    </div>

    <div>
        <label>Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div>
        <label>End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div>
        <label>Upload Agreement (PDF)</label>
        <input type="file" name="file" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>